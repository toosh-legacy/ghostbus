# GhostBus configuration (environment variables only). Copy to .env for local overrides.
MODE=lite                      # lite | full
# LAKE_DIR=./lake
# VAR_DIR=./var
DATABASE_URL=                  # empty => sqlite var/app.db ; full: postgresql+psycopg://ghostbus:ghostbus@localhost:15433/ghostbus
REDIS_URL=redis://localhost:6379/0
STREAM_BUS=memory              # memory | redis | eventhubs (Phase C)
LIVE_STATE=memory              # memory | redis
LAKE_STORE=local               # local | azurite | adls (Phase C)
GROUND_TRUTH_SOURCE=real       # real | synthetic (set automatically when D2 download fails)
RECORDER_INTERVAL_S=20         # never below 15
RECORDER_USER_AGENT=GhostBus/0.1 (open-source transit reliability research project; polite polling 20s)
ADMIN_TOKEN=dev-admin-token
COPILOT_PROVIDER=offline       # offline | ollama | azure_openai (Phase C)
# Phase C (Azure) - not used locally:
# AZURE_EVENTHUBS_CONNECTION=  AZURE_STORAGE_ACCOUNT=  AZURE_OPENAI_ENDPOINT=  AZURE_ML_ENDPOINT=
